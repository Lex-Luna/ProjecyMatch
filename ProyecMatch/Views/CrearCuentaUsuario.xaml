<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:degradado="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             NavigationPage.HasNavigationBar="False"
             x:Class="ProyecMatch.Views.CrearCuenta">

    <Grid>
        <!-- Fondo degradado que ocupa toda la pantalla -->
        <degradado:PancakeView 
            BackgroundGradientStartPoint="0,1"
            BackgroundGradientEndPoint="0,0">
            <degradado:PancakeView.BackgroundGradientStops>
                <degradado:GradientStopCollection>
                    <degradado:GradientStop Color="#132C6A" Offset="0.1"/>
                    <degradado:GradientStop Color="#350A56" Offset="0.9"/>
                </degradado:GradientStopCollection>
            </degradado:PancakeView.BackgroundGradientStops>
        </degradado:PancakeView>

        <!-- ScrollView para el contenido -->
        <ScrollView>
            <StackLayout 
                Spacing="15"
                Padding="20">

                <!-- Imagen de usuario -->
                <Image Source="logo_projectmatch_.jpg"
                       HeightRequest="100"
                       WidthRequest="100"
                       HorizontalOptions="Center"
                       Aspect="AspectFit"/>

                <!-- Título "Crear cuenta usuario" -->
                <Label Text="Crear cuenta usuario"
                       TextColor="White"
                       FontSize="24"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,10"/>

                <!-- Campos de entrada -->
                <Entry TextColor="White" 
                       FontAttributes="Bold" 
                       PlaceholderColor="#7F7F7F"
                       Placeholder="Nombre"
                       Text="{Binding TxtNombre}"/>

                <Entry TextColor="White" 
                       FontAttributes="Bold" 
                       PlaceholderColor="#7F7F7F"
                       Placeholder="Apellido"
                       Text="{Binding TxtApellido}"/>

                <Entry TextColor="White" 
                       FontAttributes="Bold" 
                       Text="{Binding TxtCorreo}"
                       PlaceholderColor="#7F7F7F"
                       Placeholder="Correo"/>

                <Entry TextColor="White" 
                       FontAttributes="Bold"
                       Text="{Binding TxtPassword}"
                       PlaceholderColor="#7F7F7F"
                       Placeholder="Contraseña"
                       IsPassword="True"/>

                <Entry TextColor="White" 
                       FontAttributes="Bold"
                       PlaceholderColor="#7F7F7F"
                       Placeholder="País actual"
                       Text="{Binding TxtPaisActual}"/>

                <Entry TextColor="White" 
                       FontAttributes="Bold"
                       PlaceholderColor="#7F7F7F"
                       Placeholder="Ciudad actual"
                       Text="{Binding TxtCiudadActual}"/>

                <!-- Editor (TextArea) para la descripción -->
                <Editor TextColor="White" 
                        FontAttributes="Bold"
                        PlaceholderColor="#7F7F7F"
                        Placeholder="Descripción del personaje"
                        Text="{Binding TxtDescripPersonaje}"
                        AutoSize="TextChanges"
                        HeightRequest="100"
                        BackgroundColor="Transparent"/>

                <!-- Botones -->
                <Button Text="Crear cuenta"
                        Command="{Binding btnCrearcuentaComand}"
                        BackgroundColor="#ACCBE4"
                        TextColor="Black"
                        CornerRadius="10"
                        HeightRequest="50"
                        Margin="0,20,0,0"
                        FontAttributes="Bold"/>

                <Button Text="Volver"
                        Command="{Binding Volvercomamd}"
                        BackgroundColor="#ACCBE4"
                        TextColor="Black"
                        CornerRadius="10"
                        HeightRequest="50"
                        Margin="0,10,0,30"
                        FontAttributes="Bold"/>
            </StackLayout>
        </ScrollView>
    </Grid>

</ContentPage>